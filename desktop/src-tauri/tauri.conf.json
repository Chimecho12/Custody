{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "itx",
  "version": "0.3.0",
  "identifier": "dev.itx.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"itx · 경로 보호","width":1320,"height":920,"minWidth":900,"minHeight":680}],
    "security": {"csp":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"}
  },
  "bundle": {"active":true,"targets":["nsis"],"externalBin":["binaries/itx-agent"],"icon":["icons/icon.ico"],"windows":{"nsis":{"installMode":"currentUser"}}}
}
